<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SMMS.Master.cs" Inherits="SuperMarketManagementSystem.SMMS.Customer.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
	<meta name='viewport' content='width=device-width, initial-scale=1'>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

	<script src="../Asset/Lib/js/jquery-1.11.1.min.js"></script>
	<link href="../Asset/Lib/css/bootstrap.css" rel="stylesheet" type="text/css" media="all" />
    <link href="../Asset/Lib/css/style.css" rel="stylesheet" type="text/css" media="all" />
	<link href="../Asset/Lib/css/font-awesome.css" rel="stylesheet"> 
	<style>
		.agileits_header {
			background: #212121;
			padding: 12px 0;
		}
		.btn {
			margin-left: 50px;
			background-color: #fe2626;
			color: white;
		}
		.btn:hover {
			color: whitesmoke;
		}
		.navigation-agileits {
			background: #fe2121;
		}
		button.btn.btn-default.search {
			background: #fe2626;
			padding: 11px 12px 11px;
			float: right;
			outline: none;
			border: none;
		}
		.w3ls_logo_products_left h1 a{
			font-size: 40px;
			color: #fe2626;
			text-decoration: none;
			text-transform: uppercase;
			display: block;
			line-height: 1;
		}
		.my-cart-icon-affix i {
			background: #fe2626 !important;
		}
		.w3l_offers p a {
			color: #fe2626;
			text-decoration: none;
		}
		ul.multi-column-dropdown h6 {
			font-size: 20px;
			color:#fe2626;
			margin: 0 0 0em;
			padding-bottom: 1em;
			border-bottom: 1px solid #E4E4E4;
			text-transform: capitalize;
		}
		.agile_top_brand_left_grid:hover .snipcart-details input.button, .snipcart-details input.button:hover {
			background: #fe2626;
		}
		.product_list_header input.button {
			color: #fff;
			font-size: 14px;
			outline: none;
			text-transform: capitalize;
			padding: .5em 2.5em .5em 1em;
			border: 1px solid #fe2626;
			margin: .35em 0 0;
			background: url(../images/cart.png) no-repeat 116px 9px;
		}
		#PPMiniCart .minicart-submit:hover{
			background:#fe2626 !important;
			border-color: #5b951a !important;
		}
		.nav-tabs>li>a:hover, .nav>li>a:focus {
			text-decoration: none;
			background: #fe2626;
			color: #FFF;
			border:  0px solid transparent;
		}
		.nav-tabs>li.active>a, .nav-tabs>li.active>a:hover, .nav-tabs>li.active>a:focus {
			color: #FFF;
			background: #fe2626;
			border:  0px solid transparent;
		}
		.w3_footer_grid ul.address li i {
			color: #fe2626;
			border: 1px solid #fe2626;
			padding: .5em;
			margin-right: 1em;
		}
		.w3_footer_grid ul li a:hover {
			color:#fe2626;
		}
		i.fa.fa-arrow-right {
			color: #fe2626;
			margin-right: 10px;
		}
		.login-form-grids input[type="submit"]:hover {
			background: #fe2626;
		}
		.login p a{
			color:#fe2626;
			text-decoration:none;
			font-size: 1.2em;
			padding: 0 .5em;
		}
		.register-home a:hover {
			background: #fe2626;
		}
		.timetable_sub th {
			background: #fe2626;
			color: #fff !important;
			text-transform: capitalize;
			font-size: 13px;
			border-right: 1px solid #fe2626;
		}
		.checkout-right-basket a:hover {
			background: #fe2626;
		}
		.time-top {
			padding: 1em;
			background-color: #fe2626;
		}
		h3.icon-subheading {
			font-size: 28px;
			color: #fe2626 !important;
			margin: 30px 0 15px;
			font-weight: 600;
			letter-spacing: 2px;
		}
		.agileits_w3layouts_map_pos{
			position: absolute;
			right: -15%;
			top: 22%;
			width: 50%;
			padding: 2em;
			background: #fe2626;
		}
	</style>
</head>
